# =============================================================================
# WorkBase — Environment Variables
# Skopiuj do .env i uzupełnij wartości
# =============================================================================

# --- PostgreSQL ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=workbase
DATABASE_USER=workbase
DATABASE_PASSWORD=workbase

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=workbase
KEYCLOAK_CLIENT_ID=workbase-web
KEYCLOAK_CLIENT_SECRET=workbase-api-dev-secret
KEYCLOAK_API_CLIENT_ID=workbase-api
KEYCLOAK_API_CLIENT_SECRET=workbase-api-dev-secret

# --- MinIO (S3-compatible file storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=workbase
MINIO_USE_SSL=false

# --- Seq (structured logging) ---
SEQ_URL=http://localhost:5341

# --- Hangfire ---
# Panel jobow pod /hangfire. Na produkcji wylaczony; dostep i tak wymaga roli workbase-admin.
HANGFIRE_DASHBOARD_ENABLED=true

# --- Keycloak: konto serwisowe do zarzadzania uzytkownikami ---
# Uzywane przez KeycloakAdminService (zakladanie kont pracownikow, role, wylogowanie).
# Bez tego zaproszenia pracownikow i nadawanie rol nie zadzialaja.
Keycloak__Admin__ClientId=admin-cli
Keycloak__Admin__Username=admin
Keycloak__Admin__Password=admin

# --- Limity zadan (RateLimitingExtensions) ---
# Globalny limit dzielony po tenant_id z tokenu, a dla ruchu bez logowania po adresie IP.
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60
RateLimiting__QueueLimit=10
# Osobny, ostrzejszy limit rejestracji samoobslugowej (na godzine, per IP).
RateLimiting__OnboardingPermitLimit=5

# --- ClamAV: skanowanie wgrywanych plikow ---
# Enabled=false wylacza skanowanie calkowicie (dev). Przy Enabled=true i niedostepnym skanerze
# AllowUploadWhenScannerUnavailable decyduje, czy upload przechodzi (false = fail-closed).
ClamAv__Enabled=false
ClamAv__Host=localhost
ClamAv__Port=3310
ClamAv__TimeoutSeconds=60
ClamAv__AllowUploadWhenScannerUnavailable=false

# --- Poczta wychodzaca ---
# Uzywana przez zaproszenia do kiosku ORAZ przez powiadomienia, gdy pracownik wlaczy sobie
# kanal pocztowy w /powiadomienia. Kanal jest opt-in, wiec bez konfiguracji nic sie nie psuje:
# wysylka konczy sie ostrzezeniem w logu, a powiadomienie w aplikacji dochodzi normalnie.
# W dev wystarczy lokalny przechwytywacz (np. MailHog na 1025).
#
# PORT 587, NIE 465. SmtpEmailSender laczy sie przez StartTlsWhenAvailable, ktore na porcie
# 465 (natychmiastowy TLS) nie zadziala. Na produkcji uzywamy tego samego konta Resend co Hub,
# ale Hub stoi na nodemailerze z secure=true na 465 — przepisanie ustawien jeden do jednego
# daje konfiguracje wygladajaca poprawnie i niedzialajaca. Szczegoly: docs/OPERACJE.md.
Smtp__Host=localhost
Smtp__Port=1025
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=noreply@workbase.local
Smtp__FromName=WorkBase

# --- WB Platform (Hub): provisioning firm, entitlements, SSO ---
# Enabled=false => WorkBase dziala samodzielnie na lokalnych feature flags, bez logowania z Huba.
# Wszystkie mechanizmy Huba sa fail-soft: brak Huba nie wywraca aplikacji.
Hub__Enabled=false
Hub__BaseUrl=http://localhost:4100
Hub__Issuer=https://wb-platform.pl
Hub__InstanceId=
Hub__ClientId=workbase
Hub__ClientSecret=
Hub__WebhookSecret=
Hub__TenantId=00000000-0000-0000-0000-000000000001
Hub__FrontendUrl=http://localhost:5173
# Cykliczne zapraszanie pracownikow do produktu po stronie Huba.
Hub__EmployeeAccessSyncEnabled=false
# Sprawdzanie przy logowaniu, czy uzytkownik ma nadal dostep do instancji w Hubie.
Hub__UserAccessCheckEnabled=false

# --- WB Ecosystem: WorkBase -> Rytm (optional) ---
Ecosystem__Enabled=false
Ecosystem__BaseUrl=http://localhost:4200
Ecosystem__Secret=
Ecosystem__TenantId=00000000-0000-0000-0000-000000000001
Ecosystem__HubOrgId=
Ecosystem__TimeZone=Europe/Warsaw
# Adres interfejsu WorkBase, uzywany w odnosnikach przy zadaniach wysylanych do Rytmu.
Ecosystem__AppUrl=http://localhost:5173
Ecosystem__ClosedTaskWindowDays=30

# --- WB Ecosystem: powiadomienia WorkBase -> czat ---
ChatNotices__Enabled=false
ChatNotices__EndpointUrl=
ChatNotices__FrontendUrl=http://localhost:5173

# --- WB Ecosystem: wyszukiwarka zadan dla innych aplikacji ---
# GET /api/ecosystem/tasks. Bez sekretu endpoint zwraca 404 (fail-closed) niezaleznie od Enabled.
TaskSearch__Enabled=false
TaskSearch__Secret=

# --- Integracje zewnetrzne (modul wycofany z ModuleCatalog 2026-08-24) ---
# Klucze zostaja w konfiguracji na czas powrotu modulu — patrz docs/PLAN-ROZWOJU-2026-08.md.
# EncryptionKey szyfruje zapisane tokeny OAuth.
Integration__EncryptionKey=
Integration__Google__ClientId=
Integration__Google__ClientSecret=
Integration__Microsoft__ClientId=
Integration__Microsoft__ClientSecret=


# --- Stripe (billing webhook) ---
# Wymagane, aby endpoint /api/billing/webhook przyjmował zdarzenia (fail-closed jeśli puste)
STRIPE_WEBHOOK_SECRET=

# --- Application ---
APP_URL=https://localhost:5001
FRONTEND_URL=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development
